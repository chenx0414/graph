{
  "name": "graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:m0": "vitest run tests/m0",
    "test:m1": "vitest run tests/m1",
    "test:m2": "vitest run tests/m2",
    "test:m3": "vitest run tests/m3",
    "test:m4": "vitest run tests/m4",
    "test:m5": "vitest run tests/m5",
    "test:m6": "vitest run tests/m6",
    "test:m7": "vitest run tests/m7",
    "build:web": "vite build",
    "demo:m1": "node examples/m1-demo.ts",
    "accept:m7": "node examples/m7-acceptance.ts",
    "accept:m7:contract": "node examples/m7-contract.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@xyflow/react": "12.11.6",
    "elkjs": "0.12.0",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
