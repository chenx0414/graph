{
  "name": "graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "check:comments": "go -C backend run ./cmd/graphcheck comments",
    "check:comments:changed": "go -C backend run ./cmd/graphcheck comments --changed",
    "skills:lint": "node scripts/skills-lint.mjs",
    "start": "go -C backend run ./cmd/graphbuild backend --if-missing && node src/server/cli.ts",
    "start:execute": "go -C backend run ./cmd/graphbuild backend --if-missing && node src/server/cli.ts --execute",
    "session:summary": "node scripts/session-summary.mjs",
    "catalog:refresh": "node scripts/refresh-models-dev.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:harness": "node scripts/harness-behavior-gate.mjs",
    "eval:harness": "node scripts/harness-eval-report.mjs",
    "check:full": "python3 scripts/check-queue.py --continue -- go -C backend run ./cmd/graphcheck all",
    "check:tokens": "go -C backend run ./cmd/graphcheck tokens",
    "check:tokens:changed": "go -C backend run ./cmd/graphcheck tokens --changed",
    "check:ownership": "go -C backend run ./cmd/graphcheck ownership",
    "check": "python3 scripts/check-queue.py",
    "check:run": "python3 scripts/check-queue.py --continue",
    "app:build": "go -C backend run ./cmd/graphbuild app",
    "build:backend": "go -C backend run ./cmd/graphbuild backend",
    "check:backend": "go -C backend run ./cmd/graphbuild backend && go -C backend vet ./... && go -C backend test ./... && go -C app vet ./... && go -C app test ./...",
    "pig:kernel": "node scripts/pig-kernel-update.mjs",
    "pig:update": "node scripts/pig-kernel-update.mjs --set latest",
    "pig:check": "node scripts/pig-kernel-update.mjs --check",
    "check:app": "go -C app vet ./... && go -C app test ./..."
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {}
}
