{
  "name": "graph",
  "version": "0.1.0",
  "main": "desktop/main.mjs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "node scripts/check-floating-promises.mjs",
    "skills:lint": "node scripts/skills-lint.mjs",
    "test": "vitest run",
    "test:design-examples": "vitest run tests/console/design-examples.test.ts",
    "test:m0": "vitest run tests/m0",
    "test:m1": "vitest run tests/m1",
    "test:m2": "vitest run tests/m2",
    "test:m3": "vitest run tests/m3",
    "test:m4": "vitest run tests/m4",
    "test:m5": "vitest run tests/m5",
    "test:m6": "vitest run tests/m6",
    "test:m7": "vitest run tests/m7",
    "build:web": "vite build",
    "start": "node scripts/build-backend.mjs --if-missing && node src/server/cli.ts",
    "start:execute": "node scripts/build-backend.mjs --if-missing && node src/server/cli.ts --execute",
    "dev": "vite",
    "session:summary": "node scripts/session-summary.mjs",
    "catalog:refresh": "node scripts/refresh-models-dev.mjs",
    "demo:m1": "node examples/m1-demo.ts",
    "accept:m7": "node examples/m7-acceptance.ts",
    "accept:m7:contract": "node examples/m7-contract.ts",
    "check:evidence": "node scripts/check-evidence.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=tests/.suite-report.json",
    "check:baseline": "node scripts/check-test-baseline.mjs",
    "check": "node --run check:backend && node --run typecheck && node --run lint && node --run test:report && node --run check:baseline && node --run check:evidence",
    "e2e:console": "node scripts/console-ui-e2e.ts",
    "e2e:sediment": "node scripts/skill-sediment-e2e.ts",
    "app:verify": "node scripts/app-verify.mjs",
    "app:dev": "electron desktop/main.mjs",
    "app:smoke": "GRAPH_APP_SMOKE=1 electron desktop/main.mjs",
    "app:icons": "node scripts/make-icons.mjs",
    "app:build": "node --run build:backend && node scripts/make-icons.mjs && node --run build:web && node scripts/package-app.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "check:backend": "node --run build:backend && go -C backend vet ./..."
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "pi-mcp-adapter": "2.38.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
