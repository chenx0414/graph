{
  "machines": [
    {
      "id": "provider_call.state",
      "title": "模型调用状态",
      "store": "table",
      "owner": "core_kernel_provider_calls.go",
      "targets": [
        {
          "table": "kernel_provider_calls",
          "column": "state"
        }
      ],
      "initial": [
        "inflight"
      ],
      "states": [
        {
          "name": "inflight",
          "label": "调用中",
          "tone": "running"
        },
        {
          "name": "settled",
          "label": "已结算",
          "tone": "success"
        },
        {
          "name": "reconciled",
          "label": "已对账",
          "tone": "success",
          "terminal": true
        },
        {
          "name": "unknown",
          "label": "用量未知",
          "tone": "blocked"
        }
      ],
      "transitions": [
        {
          "from": "inflight",
          "to": "settled",
          "on": "usage"
        },
        {
          "from": "inflight",
          "to": "reconciled",
          "on": "usage"
        },
        {
          "from": "inflight",
          "to": "unknown",
          "on": "interrupt"
        },
        {
          "from": "unknown",
          "to": "settled",
          "on": "usage"
        },
        {
          "from": "unknown",
          "to": "reconciled",
          "on": "reconcile"
        },
        {
          "from": "settled",
          "to": "reconciled",
          "on": "reconcile"
        }
      ]
    },
