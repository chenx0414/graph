{
  "machines": [
    {
      "id": "work_request.state",
      "title": "工作请求状态",
      "store": "table",
      "owner": "core_task_work_requests.go",
      "targets": [
        {
          "table": "work_requests",
          "column": "state"
        }
      ],
      "initial": [
        "clarifying"
      ],
      "states": [
        {
          "name": "clarifying",
          "label": "澄清中",
          "tone": "running"
        },
        {
          "name": "ready",
          "label": "就绪",
          "tone": "idle"
        },
        {
          "name": "dispatched",
          "label": "已派发",
          "tone": "running"
        },
        {
          "name": "completed",
          "label": "已完成",
          "tone": "success",
          "terminal": true
        },
        {
          "name": "cancelled",
          "label": "已取消",
          "tone": "muted",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "from": "clarifying",
          "to": "ready",
          "on": "confirm"
        },
        {
          "from": "clarifying",
          "to": "cancelled",
          "on": "cancel"
        },
        {
          "from": "clarifying",
          "to": "dispatched",
          "on": "dispatch"
        },
        {
          "from": "ready",
          "to": "clarifying",
          "on": "revise"
        },
        {
          "from": "ready",
          "to": "dispatched",
          "on": "dispatch"
        },
        {
          "from": "ready",
          "to": "cancelled",
          "on": "cancel"
        },
        {
          "from": "dispatched",
          "to": "completed",
          "on": "finish"
        },
        {
          "from": "dispatched",
          "to": "cancelled",
          "on": "cancel"
        }
      ]
    },
