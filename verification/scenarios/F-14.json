{
  "id": "F-14",
  "feature": "F-14",
  "description": "设置页：点侧栏「设置」后出现运行设置页签与面板，配置、限额、启动模式都能从 daemon 回读。",
  "steps": [
    {
      "verb": "waitText",
      "text": "设置",
      "timeoutMs": 20000
    },
    {
      "verb": "click",
      "name": "设置"
    },
    {
      "verb": "waitText",
      "text": "标签页 运行设置",
      "timeoutMs": 15000
    },
    {
      "verb": "assertText",
      "text": "运行设置"
    },
    {
      "verb": "waitText",
      "text": "供应商",
      "timeoutMs": 15000
    },
    {
      "verb": "click",
      "name": "标签页 运行设置"
    },
    {
      "verb": "waitText",
      "text": "关闭",
      "timeoutMs": 15000,
      "skipInWindow": true
    },
    {
      "verb": "click",
      "name": "打开 扩展自动更新",
      "skipInWindow": true
    },
    {
      "verb": "waitText",
      "text": "开启",
      "timeoutMs": 15000,
      "skipInWindow": true
    },
    {
      "verb": "click",
      "name": "打开 扩展自动更新",
      "skipInWindow": true
    },
    {
      "verb": "waitText",
      "text": "关闭",
      "timeoutMs": 15000,
      "skipInWindow": true
    },
    {
      "verb": "screenshot",
      "path": "settings.png"
    }
  ],
  "checks": [
    {
      "id": "settings.config",
      "method": "GET",
      "path": "/api/config",
      "expectStatus": 200
    },
    {
      "id": "settings.limits",
      "method": "GET",
      "path": "/api/limits",
      "expectStatus": 200
    },
    {
      "id": "settings.startup",
      "method": "GET",
      "path": "/api/startup",
      "expectStatus": 200,
      "expect": {
        "mode": "view"
      }
    }
  ]
}
