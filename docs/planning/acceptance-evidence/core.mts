// Acceptance diagnostics for d0193bb. Run from the Graph repository root.
// Prints observed behavior; exit code 0 is not a product acceptance verdict.
import { createHash } from 'node:crypto';
import { mkdtemp, readFile, writeFile, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { openTaskRuntime } from '../../../src/core/task-runtime.ts';
import { git as runGit } from '../../../src/git/git.ts';
import { testModelRuntime } from '../../../tests/fixtures/models.ts';
const usage={input:10,output:10,cacheRead:0,cacheWrite:0};
const digest=(x:string)=>createHash('sha256').update(x).digest('hex');
const worker={id:'work',kind:'agent',action:'work',definitionVersion:'coder@1',model:'writer'};
const checker={id:'check',kind:'program',action:'check',dependsOn:['work']};
function git(cwd:string,args:string[]){const r=runGit(cwd,args);if(r.code)throw Error(r.stderr);return r.stdout;}
async function setup(name:string,make:(root:string)=>any){
 const root=await mkdtemp(join(tmpdir(),'graph-review-'+name+'-'));
 git(root,['init','-b','main']); await writeFile(join(root,'README.md'),'project\n');git(root,['add','.']);git(root,['commit','-m','init']);
 const spec=await make(root);
 const runtime=await openTaskRuntime({stateDir:join(root,'state'),projects:[{id:'p',root}],actions:spec.actions,...(spec.models?{models:spec.models}:{})});
 runtime.catalog.publishDefinition('coder',{recommendedGrade:'high'},'coder');runtime.catalog.publishDefinition('reviewer',{recommendedGrade:'high',review:true},'reviewer');
 const {taskId}=await runtime.user.begin({projectId:'p',request:'acceptance probe',requestId:'begin'});
 const supervisor=runtime.supervisor(taskId);
 const proposal=await supervisor.propose({requirementVersion:1,summary:'probe',acceptance:spec.acceptance??[{id:'works',description:'Feature works',checkNode:'check'}],nodes:spec.nodes},'proposal');
 const task=runtime.user.task(taskId);await task.accept({proposalVersion:proposal.proposalVersion,targetBranch:'main',requestId:'accept'});
 try {await spec.probe({runtime,task,taskId,root,supervisor});}finally{await runtime.close();await rm(root,{recursive:true,force:true});}
}
const work={kind:'agent',reserveTokens:100,prepare:async op=>async()=>{await writeFile(join(op.workspace,'feature.txt'),'done');return{outcome:'completed',output:null,usage};}};
const check={kind:'program',prepare:async op=>async()=>({outcome:'completed',output:null,evidence:[{acceptanceId:'works',summary:'observed',artifact:{path:join(op.workspace,'feature.txt'),digest:digest('done')}}]})};
await setup('failing-review',root=>({actions:{work,check,review:{kind:'agent',reserveTokens:100,prepare:async()=>async()=>({outcome:'completed',output:{verdict:'fail',reason:'Must fix regression'},usage})}},nodes:[worker,checker,{id:'review',kind:'agent',action:'review',definitionVersion:'reviewer@1',model:'writer',dependsOn:['check']}],probe:async({runtime,task,root})=>{await runtime.host.drive();const v=await task.view();console.log('FAILING_REVIEW',JSON.stringify({phase:v.phase,verdict:v.operations.find(x=>x.nodeId==='review').result.output,targetFeaturePresent:await readFile(join(root,'feature.txt'),'utf8').then(()=>true,()=>false),questions:v.questions.map(x=>x.kind)}));}}));
await setup('transitive-review',async root=>({models:{entries:[{id:'writer',provider:'graph-openai',grade:'high',api:'openai-completions',baseUrl:'http://127.0.0.1:1',contextWindow:32000,maxTokens:256}],apiKey:'local-unused',modelRuntime:await testModelRuntime()},actions:{work,check,review:{kind:'agent',reserveTokens:100,prepare:async()=>async()=>({outcome:'completed',output:{verdict:'pass'},usage})}},nodes:[worker,checker,{id:'review',kind:'agent',action:'review',definitionVersion:'reviewer@1',model:'writer',dependsOn:['check']}],probe:async({runtime,task})=>{await runtime.host.drive();const v=await task.view();console.log('SAME_MODEL_REVIEW',JSON.stringify({phase:v.phase,models:v.nodes.filter(x=>x.kind==='agent').map(x=>({id:x.id,model:x.selectedModel})),questions:v.questions}));}}));
await setup('other-worktree',async root=>{git(root,['checkout','-b','other']);const target=join(root,'..',root.split('/').at(-1)+'-target');git(root,['worktree','add',target,'main']);await writeFile(join(target,'README.md'),'human dirty edit\n');return{actions:{work,check},nodes:[worker,checker],probe:async({runtime,task,root})=>{try{await runtime.host.drive();const v=await task.view();console.log('TARGET_WORKTREE',JSON.stringify({phase:v.phase,questions:v.questions,targetStatus:git(target,['status','--porcelain']),targetFeaturePresent:await readFile(join(target,'feature.txt'),'utf8').then(()=>true,()=>false)}));}finally{await rm(target,{recursive:true,force:true});}}};});
await setup('human-stale',root=>({actions:{work},nodes:[worker,{...checker,action:'graph.human_check'}],probe:async({runtime,task,root})=>{await runtime.host.drive();let v=await task.view();await writeFile(join(root,'target.txt'),'target moved after inspection');git(root,['add','target.txt']);git(root,['commit','-m','target advanced']);await task.answer(v.questions.find(x=>x.kind==='human_check').id,{type:'acknowledge'},'human-once');await runtime.host.drive();v=await task.view();console.log('STALE_HUMAN',JSON.stringify({phase:v.phase,humanQuestions:v.questions.filter(x=>x.kind==='human_check').length,humanCheckRuns:v.operations.filter(x=>x.nodeId==='check').length,evidence:v.evidence.map(x=>({valid:x.valid,commit:x.commitSha})),target:git(root,['rev-parse','HEAD'])}));}}));
await setup('weaken-dimension',root=>{
 const verifier={kind:'multiview',subjectNode:'work',reportNodes:['review'],dimensions:[{id:'correctness',required:true,reportNode:'review'}]};
 const nodes=[worker,{id:'review',kind:'agent',action:'review',definitionVersion:'reviewer@1',model:'reader',dependsOn:['work']},{id:'gate',kind:'program',action:'graph.verify',dependsOn:['work','review'],verifier}];
 return {actions:{work:{...work,prepare:async op=>async()=>{await writeFile(join(op.workspace,'feature.txt'),'done');return {outcome:'completed',output:null,usage,artifacts:[{id:'feature',path:join(op.workspace,'feature.txt'),digest:digest('done')}]};}},review:{kind:'agent',reserveTokens:100,prepare:async op=>async()=>{const a=op.dependencySources.work[0].artifacts[0];return{outcome:'completed',usage,output:{schemaVersion:1,subject:a,body:{kind:'multiview',dimensions:{correctness:{verdict:'fail',reason:'Required behavior broken',evidence:[a]}}}}};}}},acceptance:[{id:'works',description:'Required correctness passes',checkNode:'gate'}],nodes,probe:async({runtime,task,supervisor})=>{const revised=nodes.map(n=>n.id==='gate'?{...n,verifier:{...verifier,dimensions:[{id:'correctness',required:false,reportNode:'review'}]}}:n);let revisionAccepted=true,revisionError='';try{await supervisor.revise({baseVersion:1,reason:'Treat correctness as a suggestion',nodes:revised,requestId:'weaken'});}catch(error){revisionAccepted=false;revisionError=String(error);}await runtime.host.drive();const v=await task.view();console.log('WEAKEN_DIMENSION',JSON.stringify({phase:v.phase,graphVersion:v.graphVersion,revisionAccepted,revisionError,gate:v.operations.find(x=>x.nodeId==='gate').result?.output??null,questions:v.questions.map(x=>x.kind)}));}};
});
await setup('jury-one-ineligible',root=>{
 const config={kind:'jury',reportNodes:['jury'],hardCriteria:['builds'],ranking:[{id:'quality',weight:1,min:0,max:10}],tieOrder:['quality'],candidates:[{id:'a',node:'a'},{id:'b',node:'b'}]};
 return {nodes:[{...worker,id:'a',action:'candidate'},{...worker,id:'b',action:'candidate'},{...worker,id:'jury',action:'jury',dependsOn:['a','b']},{id:'gate',kind:'program',action:'graph.verify',dependsOn:['a','b','jury'],verifier:config}],acceptance:[{id:'works',description:'Select qualified best candidate',checkNode:'gate'}],actions:{candidate:{kind:'agent',reserveTokens:100,prepare:async op=>async()=>{const path=join(op.workspace,op.nodeId+'.txt');await writeFile(path,op.nodeId);return{outcome:'completed',output:null,usage,artifacts:[{id:op.nodeId,path,digest:digest(op.nodeId)}]};}},jury:{kind:'agent',reserveTokens:100,prepare:async op=>async()=>({outcome:'completed',usage,output:{schemaVersion:1,body:{kind:'jury',candidates:['a','b'].map(id=>{const artifact=op.dependencySources[id][0].artifacts[0];return{id,artifact,hard:{builds:{verdict:id==='a'?'pass':'fail',reason:id==='a'?'Builds':'Does not build',evidence:[artifact]}},scores:{quality:{value:9,reason:'quality',evidence:[artifact]}}};})}}})}},probe:async({runtime,task})=>{await runtime.host.drive();const v=await task.view();console.log('JURY_ONE_INELIGIBLE',JSON.stringify({phase:v.phase,questions:v.questions.map(x=>x.kind),gate:v.operations.find(x=>x.nodeId==='gate').result.output}));}};
});
